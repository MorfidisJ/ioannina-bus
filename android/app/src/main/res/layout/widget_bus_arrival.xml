<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Stop Name & Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_stop_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 Δικαστήρια (#212)"
            android:textColor="#f8fafc"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_refresh_bg"
            android:gravity="center"
            android:text="🔄"
            android:textColor="#94a3b8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1e293b" />

    <!-- Content Area: Arrivals List -->
    <LinearLayout
        android:id="@+id/widget_arrivals_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Bus 1 Row -->
        <LinearLayout
            android:id="@+id/widget_bus_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_bus_1_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="16"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bus_1_route"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ΠΑΝΕΠΙΣΤΗΜΙΟ"
                android:textColor="#94a3b8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_bus_1_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="σε 4'"
                android:textColor="#34d399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bus 2 Row -->
        <LinearLayout
            android:id="@+id/widget_bus_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_bus_2_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="02"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bus_2_route"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ΝΟΣΟΚΟΜΕΙΟ"
                android:textColor="#94a3b8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_bus_2_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="σε 11'"
                android:textColor="#34d399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state text (when no arrivals) -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Δεν υπάρχουν διελεύσεις αυτή τη στιγμή"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Footer: Last Updated Status -->
    <TextView
        android:id="@+id/widget_updated_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="right"
        android:text="Ενημέρωση: --:--"
        android:textColor="#64748b"
        android:textSize="9sp" />

</LinearLayout>

